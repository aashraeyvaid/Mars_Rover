<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="basic_mars_rover">

  <!-- ===================================================== -->
  <!-- PARAMETERS                                            -->
  <!-- ===================================================== -->

  <xacro:property name="chassis_length" value="1.2"/>
  <xacro:property name="chassis_width"  value="0.8"/>
  <xacro:property name="chassis_height" value="0.25"/>

  <xacro:property name="wheel_radius" value="0.18"/>
  <xacro:property name="wheel_width"  value="0.12"/>

  <xacro:property name="wheel_mass" value="1.0"/>
  <xacro:property name="chassis_mass" value="20.0"/>


  <!-- ===================================================== -->
  <!-- MATERIALS                                             -->
  <!-- ===================================================== -->

  <material name="chassis_material">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>

  <material name="wheel_material">
    <color rgba="0.05 0.05 0.05 1.0"/>
  </material>


  <!-- ===================================================== -->
  <!-- BASE / CHASSIS                                        -->
  <!-- ===================================================== -->

  <link name="base_link">

    <visual>

      <origin xyz="0 0 0"/>

      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>

      <material name="chassis_material"/>

    </visual>


    <collision>

      <origin xyz="0 0 0"/>

      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>

    </collision>


    <inertial>

      <origin xyz="0 0 0"/>

      <mass value="${chassis_mass}"/>

      <inertia
        ixx="${(1/12) * chassis_mass * (chassis_width*chassis_width + chassis_height*chassis_height)}"
        ixy="0"
        ixz="0"
        iyy="${(1/12) * chassis_mass * (chassis_length*chassis_length + chassis_height*chassis_height)}"
        iyz="0"
        izz="${(1/12) * chassis_mass * (chassis_length*chassis_length + chassis_width*chassis_width)}"/>

    </inertial>

  </link>


  <!-- ===================================================== -->
  <!-- WHEEL MACRO                                           -->
  <!-- ===================================================== -->

  <xacro:macro name="wheel" params="name x y">

    <link name="${name}_wheel_link">

      <visual>

        <!-- Rotate cylinder so axle is along Y -->
        <origin
          xyz="0 0 0"
          rpy="${pi/2} 0 0"/>

        <geometry>

          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>

        </geometry>

        <material name="wheel_material"/>

      </visual>


      <collision>

        <origin
          xyz="0 0 0"
          rpy="${pi/2} 0 0"/>

        <geometry>

          <cylinder
            radius="${wheel_radius}"
            length="${wheel_width}"/>

        </geometry>

      </collision>


      <inertial>

        <origin xyz="0 0 0"/>

        <mass value="${wheel_mass}"/>

        <inertia
          ixx="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          ixy="0"
          ixz="0"
          iyy="${(1/12) * wheel_mass * (3*wheel_radius*wheel_radius + wheel_width*wheel_width)}"
          iyz="0"
          izz="${0.5 * wheel_mass * wheel_radius*wheel_radius}"/>

      </inertial>

    </link>


    <!-- ================================================= -->
    <!-- WHEEL JOINT                                        -->
    <!-- ================================================= -->

    <joint
      name="${name}_wheel_joint"
      type="continuous">

      <parent link="base_link"/>

      <child link="${name}_wheel_link"/>

      <!-- Wheel center is below chassis -->
      <origin
        xyz="${x} ${y} ${-chassis_height/2 - wheel_radius}"
        rpy="0 0 0"/>

      <!-- Wheel axle -->
      <axis xyz="0 1 0"/>

    </joint>

  </xacro:macro>


  <!-- ===================================================== -->
  <!-- LEFT WHEELS                                           -->
  <!-- ===================================================== -->

  <xacro:wheel
    name="left_front"
    x="0.42"
    y="0.46"/>

  <xacro:wheel
    name="left_middle"
    x="0.0"
    y="0.46"/>

  <xacro:wheel
    name="left_rear"
    x="-0.42"
    y="0.46"/>


  <!-- ===================================================== -->
  <!-- RIGHT WHEELS                                          -->
  <!-- ===================================================== -->

  <xacro:wheel
    name="right_front"
    x="0.42"
    y="-0.46"/>

  <xacro:wheel
    name="right_middle"
    x="0.0"
    y="-0.46"/>

  <xacro:wheel
    name="right_rear"
    x="-0.42"
    y="-0.46"/>


  <!-- ===================================================== -->
  <!-- ROS 2 CONTROL                                        -->
  <!-- ===================================================== -->

  <ros2_control
    name="GazeboSystem"
    type="system">

    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>


    <!-- LEFT FRONT -->

    <joint name="left_front_wheel_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>


    <!-- LEFT MIDDLE -->

    <joint name="left_middle_wheel_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>


    <!-- LEFT REAR -->

    <joint name="left_rear_wheel_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>


    <!-- RIGHT FRONT -->

    <joint name="right_front_wheel_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>


    <!-- RIGHT MIDDLE -->

    <joint name="right_middle_wheel_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>


    <!-- RIGHT REAR -->

    <joint name="right_rear_wheel_joint">

      <command_interface name="velocity"/>

      <state_interface name="position"/>
      <state_interface name="velocity"/>

    </joint>

  </ros2_control>


  <!-- ===================================================== -->
  <!-- GAZEBO ROS 2 CONTROL                                 -->
  <!-- ===================================================== -->

  <gazebo>

    <plugin
      filename="/opt/ros/jazzy/lib/libgz_ros2_control-system.so"
      name="gz_ros2_control::GazeboSimROS2ControlPlugin">

      <parameters>
        $(find mars_rover_description)/config/controllers.yaml
      </parameters>

    </plugin>

  </gazebo>


</robot>