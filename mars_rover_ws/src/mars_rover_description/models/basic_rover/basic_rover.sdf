<?xml version="1.0"?>

<sdf version="1.10">

  <model name="basic_rover">

    <!-- Rover is affected by physics -->
    <static>false</static>

    <!-- ================================================= -->
    <!--                     CHASSIS                       -->
    <!-- ================================================= -->

    <link name="chassis">

      <!--
        Chassis dimensions:
        Length = 1.6 m
        Width  = 1.0 m
        Height = 0.35 m

        Bottom of chassis:
        0.395 - 0.175 = 0.22 m

        This keeps the chassis bottom level with
        the wheel axle height.
      -->
      <pose>0 0 0.395 0 0 0</pose>

      <inertial>

        <mass>20.0</mass>

        <!-- Center of mass at link center -->
        <pose>0 0 0 0 0 0</pose>

        <!-- Inertia for a 1.6 x 1.0 x 0.35 box, mass 20 kg -->
        <inertia>
          <ixx>1.8729</ixx>
          <iyy>4.6646</iyy>
          <izz>5.9333</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>

      <!-- CHASSIS VISUAL -->

      <visual name="chassis_visual">

        <geometry>
          <box>
            <size>1.6 1.0 0.35</size>
          </box>
        </geometry>

        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>

      </visual>

      <!-- CHASSIS COLLISION -->

      <collision name="chassis_collision">

        <geometry>
          <box>
            <size>1.6 1.0 0.35</size>
          </box>
        </geometry>

        <surface>

          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>

        </surface>

      </collision>

    </link>

    <!-- ================================================= -->
    <!--                 FRONT LEFT WHEEL                  -->
    <!-- ================================================= -->

    <link name="front_left_wheel">

      <!-- X = forward, Y = left, Z = upward -->
      <pose>0.65 0.59 0.22 1.5708 0 0</pose>

      <inertial>

        <mass>2.0</mass>

        <!-- Solid cylinder inertia -->
        <inertia>

          <ixx>0.0499</ixx>
          <iyy>0.0484</iyy>
          <izz>0.0484</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>

        </inertia>

      </inertial>

      <visual name="front_left_wheel_visual">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>

      </visual>

      <collision name="front_left_wheel_collision">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <surface>

          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>

        </surface>

      </collision>

    </link>

    <!-- ================================================= -->
    <!--                FRONT RIGHT WHEEL                  -->
    <!-- ================================================= -->

    <link name="front_right_wheel">

      <pose>0.65 -0.59 0.22 1.5708 0 0</pose>

      <inertial>

        <mass>2.0</mass>

        <inertia>
          <ixx>0.0499</ixx>
          <iyy>0.0484</iyy>
          <izz>0.0484</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>

      <visual name="front_right_wheel_visual">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>

      </visual>

      <collision name="front_right_wheel_collision">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <surface>

          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>

        </surface>

      </collision>

    </link>

    <!-- ================================================= -->
    <!--                  REAR LEFT WHEEL                  -->
    <!-- ================================================= -->

    <link name="rear_left_wheel">

      <pose>-0.65 0.59 0.22 1.5708 0 0</pose>

      <inertial>

        <mass>2.0</mass>

        <inertia>
          <ixx>0.0499</ixx>
          <iyy>0.0484</iyy>
          <izz>0.0484</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>

      <visual name="rear_left_wheel_visual">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>

      </visual>

      <collision name="rear_left_wheel_collision">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <surface>

          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>

        </surface>

      </collision>

    </link>

    <!-- ================================================= -->
    <!--                 REAR RIGHT WHEEL                  -->
    <!-- ================================================= -->

    <link name="rear_right_wheel">

      <pose>-0.65 -0.59 0.22 1.5708 0 0</pose>

      <inertial>

        <mass>2.0</mass>

        <inertia>
          <ixx>0.0499</ixx>
          <iyy>0.0484</iyy>
          <izz>0.0484</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>

      <visual name="rear_right_wheel_visual">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>

      </visual>

      <collision name="rear_right_wheel_collision">

        <geometry>
          <cylinder>
            <radius>0.22</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <surface>

          <friction>
            <ode>
              <mu>2.0</mu>
              <mu2>2.0</mu2>
            </ode>
          </friction>

        </surface>

      </collision>

    </link>

    <!-- ================================================= -->
    <!--                       JOINTS                      -->
    <!-- ================================================= -->

    <!-- FRONT LEFT -->

    <joint name="front_left_wheel_joint" type="revolute">

      <parent>chassis</parent>
      <child>front_left_wheel</child>

      <!-- Joint position in chassis frame -->
      <pose relative_to="chassis">0.65 0.59 -0.175 0 0 0</pose>

      <axis>

        <!-- Wheel axle points along Y -->
        <xyz expressed_in="chassis">0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>100</effort>
          <velocity>20</velocity>
        </limit>

        <dynamics>
          <damping>0.1</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>

    <!-- FRONT RIGHT -->

    <joint name="front_right_wheel_joint" type="revolute">

      <parent>chassis</parent>
      <child>front_right_wheel</child>

      <pose relative_to="chassis">0.65 -0.59 -0.175 0 0 0</pose>

      <axis>

        <xyz expressed_in="chassis">0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>100</effort>
          <velocity>20</velocity>
        </limit>

        <dynamics>
          <damping>0.1</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>

    <!-- REAR LEFT -->

    <joint name="rear_left_wheel_joint" type="revolute">

      <parent>chassis</parent>
      <child>rear_left_wheel</child>

      <pose relative_to="chassis">-0.65 0.59 -0.175 0 0 0</pose>

      <axis>

        <xyz expressed_in="chassis">0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>100</effort>
          <velocity>20</velocity>
        </limit>

        <dynamics>
          <damping>0.1</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>

    <!-- REAR RIGHT -->

    <joint name="rear_right_wheel_joint" type="revolute">

      <parent>chassis</parent>
      <child>rear_right_wheel</child>

      <pose relative_to="chassis">-0.65 -0.59 -0.175 0 0 0</pose>

      <axis>

        <xyz expressed_in="chassis">0 1 0</xyz>

        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
          <effort>100</effort>
          <velocity>20</velocity>
        </limit>

        <dynamics>
          <damping>0.1</damping>
          <friction>0.0</friction>
        </dynamics>

      </axis>

    </joint>

    <!-- ================================================= -->
    <!--                     CAMERA                       -->
    <!-- ================================================= -->

    <link name="camera_link">

      <!--
           Rod top = z = 1.07

           Camera size = 0.10 m
           Half height = 0.05

           Camera center:
           1.07 + 0.05 = 1.12
      -->

      <pose>0 0 1.12 0 0 0</pose>

      <inertial>

        <mass>0.1</mass>

        <inertia>

          <ixx>0.000166667</ixx>
          <iyy>0.000166667</iyy>
          <izz>0.000166667</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>

        </inertia>

      </inertial>

      <!-- CAMERA BODY COLLISION -->

      <collision name="camera_collision">

        <geometry>

          <box>
            <size>0.1 0.1 0.1</size>
          </box>

        </geometry>

      </collision>

      <!-- CAMERA BODY VISUAL -->

      <visual name="camera_visual">

        <geometry>

          <box>
            <size>0.1 0.1 0.1</size>
          </box>

        </geometry>

      </visual>

      <!-- CAMERA SENSOR -->

      <sensor name="camera_sensor" type="camera">

        <camera>

          <horizontal_fov>1.047</horizontal_fov>

          <image>
            <width>640</width>
            <height>480</height>
          </image>

          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>

        </camera>

        <always_on>true</always_on>

        <update_rate>30</update_rate>

        <visualize>true</visualize>

        <topic>camera</topic>

      </sensor>

    </link>

    <!-- ================================================= -->
    <!--           CAMERA SUPPORT TO CAMERA JOINT          -->
    <!-- ================================================= -->

    <joint name="camera_joint" type="fixed">

      <parent>camera_support</parent>

      <child>camera_link</child>

    </joint>

    <!-- ================================================= -->
    <!--                  CAMERA SUPPORT                   -->
    <!-- ================================================= -->

    <link name="camera_support">

      <!--
        Chassis center is at z = 0.395
        Chassis top = 0.395 + 0.175 = 0.57

        Stick height = 0.50
        Therefore its center is at:
        0.57 + 0.25 = 0.82
      -->

      <pose>0 0 0.82 0 0 0</pose>

      <inertial>

        <mass>0.5</mass>

        <!-- Approximate inertia for cylindrical support -->
        <inertia>
          <ixx>0.0105</ixx>
          <iyy>0.0105</iyy>
          <izz>0.00125</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>

      <!-- VISUAL -->

      <visual name="camera_support_visual">

        <geometry>

          <cylinder>
            <radius>0.04</radius>
            <length>0.50</length>
          </cylinder>

        </geometry>

        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>

      </visual>

      <!-- COLLISION -->

      <collision name="camera_support_collision">

        <geometry>

          <cylinder>
            <radius>0.04</radius>
            <length>0.50</length>
          </cylinder>

        </geometry>

      </collision>

    </link>

    <!-- ================================================= -->
    <!--            CAMERA SUPPORT FIXED JOINT             -->
    <!-- ================================================= -->

    <joint name="camera_support_joint" type="fixed">

      <parent>chassis</parent>
      <child>camera_support</child>

      <!-- Position at the top center of the chassis -->

      <pose relative_to="chassis">0 0 0.175 0 0 0</pose>

    </joint>

    <!-- ================================================= -->
    <!--                DIFFERENTIAL DRIVE                 -->
    <!-- ================================================= -->

    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <!-- LEFT SIDE WHEELS -->

      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>

      <!-- RIGHT SIDE WHEELS -->

      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>

      <!-- Distance between left and right wheels -->

      <wheel_separation>1.18</wheel_separation>

      <!-- Wheel radius -->

      <wheel_radius>0.22</wheel_radius>

      <!-- Gazebo velocity command topic -->

      <topic>/cmd_vel</topic>

      <!-- Maximum wheel acceleration -->

      <max_linear_acceleration>1.0</max_linear_acceleration>

      <max_angular_acceleration>2.0</max_angular_acceleration>

    </plugin>


    <!-- ================================================= -->
    <!--                       LIDAR                       -->
    <!-- ================================================= -->

    <link name="lidar_link">

      <!--
        Chassis top = 0.57

        Lidar height = 0.10
        Half height = 0.05

        Lidar center = 0.57 + 0.05 = 0.62
      -->

      <pose>0.35 0 0.62 0 0 0</pose>

      <inertial>

        <mass>0.2</mass>

        <inertia>
          <ixx>0.0005</ixx>
          <iyy>0.0005</iyy>
          <izz>0.0005</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>

      <!-- LIDAR BODY -->

      <visual name="lidar_visual">

        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>

      </visual>

      <collision name="lidar_collision">

        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>

      </collision>

      <!-- 2D LIDAR SENSOR -->

      <sensor name="lidar_sensor" type="gpu_lidar">

        <topic>/scan</topic>

        <update_rate>10</update_rate>

        <ray>

          <scan>

            <horizontal>
              <samples>640</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>

            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>

          </scan>

          <range>
            <min>0.1</min>
            <max>10</max>
            <resolution>0.01</resolution>
          </range>

        </ray>

        <always_on>true</always_on>

        <visualize>true</visualize>

      </sensor>

    </link>

    <!-- ================================================= -->
    <!--                 LIDAR FIXED JOINT                 -->
    <!-- ================================================= -->
  
    <joint name="lidar_joint" type="fixed">
  
      <parent>chassis</parent>
      <child>lidar_link</child>
  
    </joint>

  </model>


</sdf>