        </dynamics>

      </axis>

    </joint>


    <!-- ========================================================= -->
    <!-- LEFT REAR SUSPENSION -->
    <!-- ========================================================= -->

    <link name="left_rear_suspension">

      <pose>-0.78 0.82 0.52 0 0 0</pose>

      <inertial>
        <mass>2</mass>
        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
