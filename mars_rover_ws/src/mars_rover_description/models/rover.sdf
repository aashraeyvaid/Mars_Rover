      </inertial>


      <collision name="collision">

        <geometry>
          <cylinder>
            <radius>0.38</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>

      </collision>


      <visual name="wheel">

        <geometry>
          <cylinder>
            <radius>0.38</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.025 0.025 0.025 1</ambient>
          <diffuse>0.06 0.06 0.06 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>

      </visual>


      <visual name="hub">

        <geometry>
          <cylinder>
            <radius>0.14</radius>
            <length>0.235</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>

      </visual>

    </link>


    <joint name="right_rear_wheel_joint"
           type="revolute">

      <parent>right_rear_suspension</parent>
      <child>right_rear_wheel</child>

      <axis>

        <xyz>0 1 0</xyz>

        <dynamics>
          <damping>0.5</damping>
          <friction>0.08</friction>
        </dynamics>

      </axis>

    </joint>


    <!-- ========================================================= -->
    <!-- SOLAR PANEL -->
    <!-- ========================================================= -->

    <!-- ========================================================= -->
    <!-- SOLAR PANEL SUPPORTS -->
    <!-- ========================================================= -->

    <link name="solar_support_left">

    <pose>0.10 0.45 1.12 0 0 0</pose>

    <inertial>

        <mass>1.5</mass>

        <inertia>
        <ixx>0.03</ixx>
        <iyy>0.03</iyy>
        <izz>0.03</izz>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyz>0</iyz>
        </inertia>

    </inertial>

    <visual name="support">

        <geometry>
        <box>
            <size>0.12 0.12 0.55</size>
        </box>
        </geometry>

        <material>

        <ambient>0.30 0.30 0.30 1</ambient>

        <diffuse>0.50 0.50 0.50 1</diffuse>

        <specular>0.8 0.8 0.8 1</specular>

        </material>

    </visual>

    </link>


    <link name="solar_support_right">

    <pose>0.10 -0.45 1.12 0 0 0</pose>

    <inertial>

        <mass>1.5</mass>

        <inertia>
        <ixx>0.03</ixx>
        <iyy>0.03</iyy>
        <izz>0.03</izz>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyz>0</iyz>
        </inertia>

    </inertial>

    <visual name="support">

        <geometry>
        <box>
            <size>0.12 0.12 0.55</size>
        </box>
        </geometry>

        <material>

        <ambient>0.30 0.30 0.30 1</ambient>

        <diffuse>0.50 0.50 0.50 1</diffuse>

        <specular>0.8 0.8 0.8 1</specular>

        </material>

    </visual>

    </link>


    <!-- Left support fixed to body -->

    <joint name="solar_support_left_joint"
        type="fixed">

    <parent>base_link</parent>

    <child>solar_support_left</child>

    </joint>


    <!-- Right support fixed to body -->

    <joint name="solar_support_right_joint"
        type="fixed">

    <parent>base_link</parent>

    <child>solar_support_right</child>

    </joint>


    <!-- ========================================================= -->
    <!-- TILTED SOLAR PANEL -->
    <!-- ========================================================= -->

    <link name="solar_panel">

    <!--
        Panel is approximately 12 degrees tilted.
        Rotation around Y axis.
    -->

    <pose>-0.45 0 1.55 0 0.21 0</pose>

    <inertial>

        <mass>8</mass>

        <inertia>

        <ixx>0.8</ixx>

        <iyy>1.0</iyy>

        <izz>0.3</izz>

        <ixy>0</ixy>

        <ixz>0</ixz>

        <iyz>0</iyz>

        </inertia>

    </inertial>


    <!-- Panel frame -->

    <visual name="panel_frame">

        <geometry>

        <box>

            <size>1.80 1.17 0.10</size>

        </box>

        </geometry>

        <material>

        <ambient>0.08 0.08 0.08 1</ambient>

        <diffuse>0.18 0.18 0.18 1</diffuse>

        <specular>0.8 0.8 0.8 1</specular>

        </material>

    </visual>


    <!-- Solar surface -->

    <visual name="panel_surface">

        <pose>0 0 0.055 0 0 0</pose>

        <geometry>

        <box>

            <size>1.68 1.05 0.025</size>

        </box>

        </geometry>

        <material>

        <ambient>0.01 0.04 0.12 1</ambient>

        <diffuse>0.02 0.12 0.40 1</diffuse>

        <specular>0.95 0.95 0.95 1</specular>

        </material>

    </visual>


    <!-- Solar cell divisions -->

    <visual name="cell_line_1">

        <pose>-0.65 0 0.072 0 0 0</pose>

        <geometry>

        <box>

            <size>0.015 1.02 0.012</size>

        </box>

        </geometry>

        <material>

        <ambient>0.75 0.75 0.80 1</ambient>

        <diffuse>0.90 0.90 0.95 1</diffuse>

        </material>

    </visual>


    <visual name="cell_line_2">

        <pose>-0.32 0 0.072 0 0 0</pose>

        <geometry>

        <box>

            <size>0.015 1.02 0.012</size>

        </box>

        </geometry>

        <material>

        <ambient>0.75 0.75 0.80 1</ambient>

        <diffuse>0.90 0.90 0.95 1</diffuse>

        </material>

    </visual>


    <visual name="cell_line_3">

        <pose>0 0 0.072 0 0 0</pose>

        <geometry>

        <box>

            <size>0.015 1.02 0.012</size>

        </box>

        </geometry>

        <material>

        <ambient>0.75 0.75 0.80 1</ambient>

        <diffuse>0.90 0.90 0.95 1</diffuse>

        </material>

    </visual>


    <visual name="cell_line_4">

        <pose>0.32 0 0.072 0 0 0</pose>

        <geometry>

        <box>

            <size>0.015 1.02 0.012</size>

        </box>

        </geometry>

        <material>

        <ambient>0.75 0.75 0.80 1</ambient>

        <diffuse>0.90 0.90 0.95 1</diffuse>

        </material>

    </visual>


    <visual name="cell_line_5">

        <pose>0.65 0 0.072 0 0 0</pose>

        <geometry>

        <box>

            <size>0.015 1.02 0.012</size>

        </box>

        </geometry>

        <material>

        <ambient>0.75 0.75 0.80 1</ambient>

        <diffuse>0.90 0.90 0.95 1</diffuse>

        </material>

    </visual>

    </link>


    <!-- ========================================================= -->
    <!-- SOLAR PANEL MOUNT JOINT -->
    <!-- ========================================================= -->

    <joint name="solar_panel_joint"
        type="fixed">

    <parent>base_link</parent>

    <child>solar_panel</child>

    </joint>

<!-- ========================================================= -->
<!-- SOLAR WIPER MOTOR -->
<!-- ========================================================= -->

<link name="wiper_motor">

  <!--
       Motor is mounted at the upper edge of the tilted
       solar panel.
  -->

  <pose>-0.40 0 1.67 0 0.21 0</pose>

  <inertial>

    <mass>1</mass>

    <inertia>

      <ixx>0.01</ixx>
      <iyy>0.01</iyy>
      <izz>0.01</izz>

      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>

    </inertia>

  </inertial>


  <!-- Motor housing -->

  <visual name="motor_body">

    <geometry>

      <cylinder>

        <radius>0.10</radius>

        <length>0.16</length>

      </cylinder>

    </geometry>

    <material>

      <ambient>0.30 0.30 0.30 1</ambient>

      <diffuse>0.65 0.65 0.65 1</diffuse>

      <specular>0.9 0.9 0.9 1</specular>

    </material>

  </visual>

</link>


<!-- Motor attached to solar panel -->

<joint name="wiper_motor_joint"
       type="fixed">

  <parent>solar_panel</parent>

  <child>wiper_motor</child>

</joint>


    <!-- ========================================================= -->
    <!-- SOLAR PANEL WIPER -->
    <!-- ========================================================= -->

    <link name="solar_wiper">

    <!--
        Same 12 degree tilt as the solar panel.
        Therefore the blade lies against the panel surface.
    -->

    <pose>-0.40 0 1.68 0 0.21 0</pose>


    <inertial>

        <mass>0.8</mass>

        <inertia>

        <ixx>0.01</ixx>
        <iyy>0.01</iyy>
        <izz>0.01</izz>

        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyz>0</iyz>

        </inertia>

    </inertial>


    <!-- Wiper arm -->

    <visual name="wiper_arm">

        <geometry>

        <box>

            <size>1.55 0.07 0.055</size>

        </box>

        </geometry>

        <material>

        <ambient>0.70 0.45 0.02 1</ambient>

        <diffuse>1.0 0.65 0.03 1</diffuse>

        <specular>0.8 0.8 0.8 1</specular>

        </material>

    </visual>


    <!-- Rubber cleaning blade -->

    <visual name="rubber_blade">

        <pose>0 0 -0.045 0 0 0</pose>

        <geometry>

        <box>

            <size>1.55 0.035 0.035</size>

        </box>

        </geometry>

        <material>

        <ambient>0.015 0.015 0.015 1</ambient>

        <diffuse>0.04 0.04 0.04 1</diffuse>

        <specular>0.2 0.2 0.2 1</specular>

        </material>

    </visual>

    </link>


    <!-- ========================================================= -->
    <!-- WIPER ROTATION JOINT -->
    <!-- ========================================================= -->

    <joint name="solar_wiper_joint"
        type="revolute">

    <parent>wiper_motor</parent>

    <child>solar_wiper</child>

    <!--
        Rotation axis is perpendicular to the solar panel.
        Because the complete assembly is tilted 12 degrees,
        the wiper rotates along the tilted panel.
    -->

    <axis>

        <xyz>0 0 1</xyz>

        <limit>

        <lower>-1.57</lower>

        <upper>1.57</upper>

        </limit>

        <dynamics>

        <damping>0.5</damping>

        <friction>0.1</friction>

        </dynamics>

    </axis>

    </joint>

    <!-- ========================================================= -->
    <!-- REAR LABORATORY -->
    <!-- ========================================================= -->

    <link name="laboratory">

      <pose>-1.20 0 1.08 0 0 0</pose>

      <inertial>

        <mass>15</mass>

        <inertia>
          <ixx>0.7</ixx>
          <iyy>0.8</iyy>
          <izz>1.0</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>


      <collision name="collision">

        <geometry>
          <box>
            <size>0.90 1.10 0.82</size>
          </box>
        </geometry>

      </collision>


      <visual name="lab_body">

        <geometry>
          <box>
            <size>0.90 1.10 0.82</size>
          </box>
        </geometry>

        <material>
          <ambient>0.70 0.70 0.70 1</ambient>
          <diffuse>0.88 0.88 0.88 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>

      </visual>


      <!-- Laboratory window -->

      <visual name="lab_window">

        <pose>0.456 0 0.08 0 1.5708 0</pose>

        <geometry>
          <box>
            <size>0.35 0.60 0.015</size>
          </box>
        </geometry>

        <material>
          <ambient>0.02 0.18 0.30 1</ambient>
          <diffuse>0.04 0.45 0.75 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>

      </visual>


      <!-- Soil sensor -->

      <visual name="soil_sensor">

        <pose>0.46 0 -0.22 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.08</radius>
            <length>0.18</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.65 0.10 0.05 1</ambient>
          <diffuse>0.95 0.18 0.05 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>

      </visual>


      <sensor name="soil_contact_sensor"
              type="contact">

        <always_on>true</always_on>
        <update_rate>20</update_rate>

        <topic>
          /rover/laboratory/soil_sensor
        </topic>

      </sensor>

    </link>


    <joint name="laboratory_joint"
           type="fixed">

      <parent>base_link</parent>
      <child>laboratory</child>

    </joint>


    <!-- ========================================================= -->
    <!-- DRILL APPENDIX BASE -->
    <!-- ========================================================= -->

    <link name="drill_arm_base">

      <pose>-1.82 0 0.90 0 0 0</pose>

      <visual name="base">

        <geometry>
          <cylinder>
            <radius>0.16</radius>
            <length>0.28</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.40 0.12 0.02 1</ambient>
          <diffuse>0.85 0.25 0.03 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>

      </visual>

    </link>


    <joint name="drill_arm_base_joint"
           type="revolute">

      <parent>base_link</parent>
      <child>drill_arm_base</child>

      <axis>

        <xyz>0 1 0</xyz>

      </axis>

      <limit>
        <lower>-1.0</lower>
        <upper>1.0</upper>
      </limit>

    </joint>


    <!-- ========================================================= -->
    <!-- DRILL ARM -->
    <!-- ========================================================= -->

    <link name="drill_arm">

      <pose>-2.25 0 0.72 0 0 0</pose>

      <inertial>

        <mass>6</mass>

        <inertia>
          <ixx>0.4</ixx>
          <iyy>0.4</iyy>
          <izz>0.1</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>


      <collision name="collision">

        <geometry>
          <box>
            <size>0.90 0.18 0.18</size>
          </box>
        </geometry>

      </collision>


      <visual name="arm">

        <geometry>
          <box>
            <size>0.90 0.18 0.18</size>
          </box>
        </geometry>

        <material>
          <ambient>0.60 0.15 0.02 1</ambient>
          <diffuse>0.95 0.32 0.03 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>

      </visual>


      <visual name="joint_end">

        <pose>0.44 0 0 0 0 0</pose>

        <geometry>
          <sphere>
            <radius>0.13</radius>
          </sphere>
        </geometry>

        <material>
          <ambient>0.5 0.5 0.5 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <specular>1 1 1 1</specular>
        </material>

      </visual>

    </link>


    <joint name="drill_arm_joint"
           type="revolute">

      <parent>drill_arm_base</parent>
      <child>drill_arm</child>

      <axis>
        <xyz>0 1 0</xyz>
      </axis>

      <limit>
        <lower>-1.2</lower>
        <upper>0.8</upper>
      </limit>

    </joint>


    <!-- ========================================================= -->
    <!-- DRILL MOTOR -->
    <!-- ========================================================= -->

    <link name="drill_motor">

      <pose>-2.70 0 0.55 0 0 0</pose>

      <visual name="motor">

        <geometry>
          <cylinder>
            <radius>0.15</radius>
            <length>0.25</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.35 0.35 0.35 1</ambient>
          <diffuse>0.65 0.65 0.65 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>

      </visual>

    </link>


    <joint name="drill_motor_joint"
           type="fixed">

      <parent>drill_arm</parent>
      <child>drill_motor</child>

    </joint>


    <!-- ========================================================= -->
    <!-- DRILL BIT -->
    <!-- ========================================================= -->

    <link name="drill">

      <pose>-2.70 0 0.18 0 0 0</pose>

      <inertial>

        <mass>4</mass>

        <inertia>
          <ixx>0.1</ixx>
          <iyy>0.1</iyy>
          <izz>0.1</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>


      <collision name="collision">

        <geometry>
          <cylinder>
            <radius>0.105</radius>
            <length>0.60</length>
          </cylinder>
        </geometry>

      </collision>


      <visual name="shaft">

        <geometry>
          <cylinder>
            <radius>0.09</radius>
            <length>0.60</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.35 0.35 0.35 1</ambient>
          <diffuse>0.65 0.65 0.65 1</diffuse>
          <specular>1 1 1 1</specular>
        </material>

      </visual>


      <visual name="tip">

        <pose>0 0 -0.34 0 0 0</pose>

        <geometry>
          <cone>
            <radius>0.15</radius>
            <length>0.20</length>
          </cone>
        </geometry>

        <material>
          <ambient>0.50 0.04 0.02 1</ambient>
          <diffuse>0.90 0.08 0.02 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>

      </visual>

    </link>


    <joint name="drill_joint"
           type="revolute">

      <parent>drill_motor</parent>
      <child>drill</child>

      <axis>

        <xyz>0 0 1</xyz>

        <dynamics>
          <damping>0.2</damping>
          <friction>0.05</friction>
        </dynamics>

      </axis>

    </joint>


    <!-- ========================================================= -->
    <!-- SAMPLE COLLECTION CHUTE -->
    <!-- ========================================================= -->

    <link name="sample_chute">

      <pose>-1.78 0 0.78 0 0 0</pose>

      <visual name="chute">

        <geometry>
          <box>
            <size>0.72 0.34 0.14</size>
          </box>
        </geometry>

        <material>
          <ambient>0.45 0.20 0.02 1</ambient>
          <diffuse>0.75 0.35 0.03 1</diffuse>
          <specular>0.4 0.4 0.4 1</specular>
        </material>

      </visual>

    </link>


    <joint name="sample_chute_joint"
           type="fixed">

      <parent>laboratory</parent>
      <child>sample_chute</child>

    </joint>


    <!-- ========================================================= -->
    <!-- CENTRAL IMU -->
    <!-- ========================================================= -->

    <link name="imu_link">

      <pose>0 0 1.16 0 0 0</pose>

      <sensor name="imu"
              type="imu">

        <always_on>true</always_on>
        <update_rate>100</update_rate>

        <topic>/rover/imu</topic>

      </sensor>

    </link>


    <joint name="imu_joint"
           type="fixed">

      <parent>brain_link</parent>
      <child>imu_link</child>

    </joint>


    <!-- ========================================================= -->
    <!-- GAZEBO HARMONIC SYSTEMS -->
    <!-- ========================================================= -->

    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics"/>

    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands"/>

    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster"/>

    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors"/>

  </model>
</sdf>