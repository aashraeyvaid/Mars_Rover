<?xml version="1.0"?>
<sdf version="1.10">
  <model name="mars_rover">

    <static>false</static>
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <!-- ========================================================= -->
    <!-- MAIN BODY / CENTRAL BRAIN -->
    <!-- ========================================================= -->

    <link name="base_link">

      <pose>0 0 0.62 0 0 0</pose>

      <inertial>
        <mass>80</mass>
        <inertia>
          <ixx>18</ixx>
          <iyy>28</iyy>
          <izz>35</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="body_collision">
        <geometry>
          <box>
            <size>2.5 1.5 0.65</size>
          </box>
        </geometry>
      </collision>

      <visual name="body_visual">

        <geometry>
          <box>
            <size>2.5 1.5 0.65</size>
          </box>
        </geometry>

        <material>
          <ambient>0.70 0.20 0.04 1</ambient>
          <diffuse>0.90 0.30 0.05 1</diffuse>
          <specular>0.25 0.25 0.25 1</specular>
        </material>

      </visual>

      <!-- Central brain enclosure -->

      <visual name="brain_enclosure_visual">

        <pose>0 0 0.38 0 0 0</pose>

        <geometry>
          <box>
            <size>0.95 0.78 0.22</size>
          </box>
        </geometry>

        <material>
          <ambient>0.03 0.15 0.55 1</ambient>
          <diffuse>0.05 0.30 0.90 1</diffuse>
          <specular>0.5 0.5 0.5 1</specular>
        </material>

      </visual>

    </link>


    <!-- ========================================================= -->
    <!-- BRAIN / MICROCONTROLLER COMPARTMENT -->
    <!-- ========================================================= -->

    <link name="brain_link">

      <pose>0 0 1.03 0 0 0</pose>

      <inertial>

        <mass>5</mass>

        <inertia>
          <ixx>0.2</ixx>
          <iyy>0.25</iyy>
          <izz>0.3</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>

      <visual name="brain_visual">

        <geometry>
          <box>
            <size>0.85 0.65 0.22</size>
          </box>
        </geometry>

        <material>
          <ambient>0.02 0.20 0.80 1</ambient>
          <diffuse>0.04 0.40 1.00 1</diffuse>
          <specular>0.7 0.7 0.7 1</specular>
        </material>

      </visual>

      <collision name="brain_collision">

        <geometry>
          <box>
            <size>0.85 0.65 0.22</size>
          </box>
        </geometry>

      </collision>

    </link>


    <joint name="brain_fixed_joint"
           type="fixed">

      <parent>base_link</parent>
      <child>brain_link</child>

    </joint>


    <!-- ========================================================= -->
    <!-- CAMERA -->
    <!-- ========================================================= -->

    <link name="camera_mount">

      <pose>1.18 0 1.02 0 0 0</pose>

      <visual name="mount_visual">

        <geometry>
          <box>
            <size>0.28 0.32 0.28</size>
          </box>
        </geometry>

        <material>
          <ambient>0.04 0.04 0.04 1</ambient>
          <diffuse>0.10 0.10 0.10 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>

      </visual>

    </link>


    <joint name="camera_mount_joint"
           type="fixed">

      <parent>base_link</parent>
      <child>camera_mount</child>

    </joint>


    <link name="camera_link">

      <pose>1.28 0 1.12 0 0 0</pose>

      <visual name="camera_body">

        <geometry>
          <box>
            <size>0.28 0.20 0.20</size>
          </box>
        </geometry>

        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>

      </visual>


      <visual name="camera_lens">

        <pose>0.145 0 0 0 1.5708 0</pose>

        <geometry>
          <cylinder>
            <radius>0.065</radius>
            <length>0.025</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.01 0.05 0.12 1</ambient>
          <diffuse>0.02 0.15 0.45 1</diffuse>
          <specular>1 1 1 1</specular>
        </material>

      </visual>


      <sensor name="front_camera"
              type="camera">

        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>

        <topic>/rover/camera/image_raw</topic>

        <camera>

          <horizontal_fov>1.047</horizontal_fov>

          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>

          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>

        </camera>

      </sensor>

    </link>


    <joint name="camera_joint"
           type="fixed">

      <parent>camera_mount</parent>
      <child>camera_link</child>

    </joint>


    <!-- ========================================================= -->
    <!-- LIDAR -->
    <!-- ========================================================= -->

<!-- ========================================================= -->
<!-- LIDAR SUPPORT -->
<!-- ========================================================= -->

<link name="lidar_support">

  <!-- Support rises from the rover body -->
  <pose>0.65 0 0.94 0 0 0</pose>

  <inertial>
    <mass>1.5</mass>
    <inertia>
      <ixx>0.03</ixx>
      <iyy>0.03</iyy>
      <izz>0.03</izz>
      <ixy>0</ixy>
      <ixz>0</ixz>
      <iyz>0</iyz>
    </inertia>
  </inertial>

  <!-- Vertical support -->
  <visual name="support">

    <geometry>
      <cylinder>
        <radius>0.09</radius>
        <length>0.55</length>
      </cylinder>
    </geometry>

    <material>
      <ambient>0.45 0.45 0.45 1</ambient>
      <diffuse>0.65 0.65 0.65 1</diffuse>
      <specular>0.8 0.8 0.8 1</specular>
    </material>

  </visual>

  <!-- Bottom mounting plate -->
  <visual name="bottom_mount">

    <pose>0 0 -0.27 0 0 0</pose>

    <geometry>
      <cylinder>
        <radius>0.20</radius>
        <length>0.06</length>
      </cylinder>
    </geometry>

    <material>
      <ambient>0.15 0.15 0.15 1</ambient>
      <diffuse>0.30 0.30 0.30 1</diffuse>
      <specular>0.7 0.7 0.7 1</specular>
    </material>

  </visual>

  <!-- Top mounting plate -->
  <visual name="top_mount">

    <pose>0 0 0.27 0 0 0</pose>

    <geometry>
      <cylinder>
        <radius>0.20</radius>
        <length>0.06</length>
      </cylinder>
    </geometry>

    <material>
      <ambient>0.15 0.15 0.15 1</ambient>
      <diffuse>0.30 0.30 0.30 1</diffuse>
      <specular>0.7 0.7 0.7 1</specular>
    </material>

  </visual>

</link>


<joint name="lidar_support_joint"
       type="fixed">

  <parent>base_link</parent>
  <child>lidar_support</child>

</joint>


<!-- ========================================================= -->
<!-- LIDAR -->
<!-- ========================================================= -->

    <link name="lidar_link">

    <pose>0.65 0 1.28 0 0 0</pose>

    <inertial>

        <mass>2</mass>

        <inertia>
        <ixx>0.04</ixx>
        <iyy>0.04</iyy>
        <izz>0.06</izz>
        <ixy>0</ixy>
        <ixz>0</ixz>
        <iyz>0</iyz>
        </inertia>

    </inertial>


    <!-- Main LiDAR body -->

    <visual name="lidar_base">

        <geometry>
        <cylinder>
            <radius>0.19</radius>
            <length>0.10</length>
        </cylinder>
        </geometry>

        <material>
        <ambient>0.20 0.03 0.35 1</ambient>
        <diffuse>0.45 0.05 0.75 1</diffuse>
        <specular>0.8 0.8 0.8 1</specular>
        </material>

    </visual>


    <!-- Rotating top -->

    <visual name="lidar_top">

        <pose>0 0 0.09 0 0 0</pose>

        <geometry>
        <cylinder>
            <radius>0.13</radius>
            <length>0.08</length>
        </cylinder>
        </geometry>

        <material>
        <ambient>0.04 0.04 0.04 1</ambient>
        <diffuse>0.12 0.12 0.12 1</diffuse>
        <specular>0.9 0.9 0.9 1</specular>
        </material>

    </visual>


    <sensor name="lidar_sensor"
            type="gpu_lidar">

        <always_on>true</always_on>

        <update_rate>15</update_rate>

        <visualize>true</visualize>

        <topic>/rover/lidar/points</topic>

        <lidar>

        <scan>

            <horizontal>

            <samples>720</samples>

            <resolution>1</resolution>

            <min_angle>-3.14159</min_angle>

            <max_angle>3.14159</max_angle>

            </horizontal>

            <vertical>

            <samples>16</samples>

            <resolution>1</resolution>

            <min_angle>-0.26</min_angle>

            <max_angle>0.26</max_angle>

            </vertical>

        </scan>

        <range>

            <min>0.15</min>

            <max>50</max>

            <resolution>0.01</resolution>

        </range>

        </lidar>

    </sensor>

    </link>


    <joint name="lidar_joint"
        type="fixed">

    <parent>lidar_support</parent>

    <child>lidar_link</child>

    </joint>

    <!-- ========================================================= -->
    <!-- LEFT FRONT SUSPENSION -->
    <!-- ========================================================= -->

    <link name="left_front_suspension">

      <pose>0.78 0.82 0.52 0 0 0</pose>

      <inertial>

        <mass>2</mass>

        <inertia>
          <ixx>0.05</ixx>
          <iyy>0.05</iyy>
          <izz>0.05</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>


      <visual name="suspension_strut">

        <geometry>
          <cylinder>
            <radius>0.07</radius>
            <length>0.42</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.55 0.30 0.02 1</ambient>
          <diffuse>0.95 0.65 0.04 1</diffuse>
          <specular>0.6 0.6 0.6 1</specular>
        </material>

      </visual>


      <visual name="spring">

        <pose>0 0 -0.20 0 0 0</pose>

        <geometry>
          <cylinder>
            <radius>0.11</radius>
            <length>0.32</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.12 0.12 0.12 1</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>

      </visual>

    </link>


    <joint name="left_front_suspension_joint"
           type="prismatic">

      <parent>base_link</parent>
      <child>left_front_suspension</child>

      <axis>

        <xyz>0 0 1</xyz>

        <limit>
          <lower>-0.16</lower>
          <upper>0.16</upper>
        </limit>

        <dynamics>
          <damping>450</damping>
          <friction>25</friction>
        </dynamics>

      </axis>

    </joint>


    <!-- LEFT FRONT WHEEL -->

    <link name="left_front_wheel">

      <pose>0.78 0.91 0.37 1.5708 0 0</pose>

      <inertial>

        <mass>5</mass>

        <inertia>
          <ixx>0.15</ixx>
          <iyy>0.15</iyy>
          <izz>0.25</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>


      <collision name="collision">

        <geometry>
          <cylinder>
            <radius>0.38</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>

      </collision>


      <visual name="wheel">

        <geometry>
          <cylinder>
            <radius>0.38</radius>
            <length>0.22</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.025 0.025 0.025 1</ambient>
          <diffuse>0.06 0.06 0.06 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>

      </visual>


      <visual name="hub">

        <geometry>
          <cylinder>
            <radius>0.14</radius>
            <length>0.235</length>
          </cylinder>
        </geometry>

        <material>
          <ambient>0.55 0.55 0.55 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <specular>0.9 0.9 0.9 1</specular>
        </material>

      </visual>

    </link>


    <joint name="left_front_wheel_joint"
           type="revolute">

      <parent>left_front_suspension</parent>
      <child>left_front_wheel</child>

      <axis>

        <xyz>0 1 0</xyz>

        <dynamics>
          <damping>0.5</damping>
          <friction>0.08</friction>
        </dynamics>

      </axis>

    </joint>


    <!-- ========================================================= -->
    <!-- RIGHT FRONT SUSPENSION -->
    <!-- ========================================================= -->

    <link name="right_front_suspension">

      <pose>0.78 -0.82 0.52 0 0 0</pose>

      <inertial>
        <mass>2</mass>
        <inertia>
